){gap: 1.25em;}:where(.wp-block-post-template.is-layout-grid){gap: 1.25em;}:where(.wp-block-term-template.is-layout-flex){gap: 1.25em;}:where(.wp-block-term-template.is-layout-grid){gap: 1.25em;}:where(.wp-block-columns.is-layout-flex){gap: 2em;}:where(.wp-block-columns.is-layout-grid){gap: 2em;}:root :where(.wp-block-pullquote){font-size: 1.5em;line-height: 1.6;}"],["STYLE",{},"/* GemReserve compact institutional footer — 2026-08-31 */\n.site-footer {\n  padding-top: clamp(48px, 5vw, 68px);\n}\n\n.footer-grid {\n  grid-template-columns: minmax(250px, 1.35fr) repeat(4, minmax(140px, 1fr));\n  align-items: start;\n  gap: clamp(28px, 3vw, 48px);\n  padding-bottom: clamp(38px, 4vw, 52px);\n}\n\n.footer-brand {\n  grid-row: auto;\n  align-self: start;\n}\n\n.footer-brand > p {\n  max-width: 30ch;\n}\n\n.footer-socials {\n  display: none;\n}\n\n/* Keep only Services, Company, Help and Legal. */\n.footer-grid > .footer-column:nth-child(n + 3):nth-child(-n + 7) {\n  display: none;\n}\n\n.footer-column h2 {\n  margin-bottom: 14px;\n  letter-spacing: 0.08em;\n}\n\n.footer-column ul {\n  gap: 8px;\n}\n\n.footer-column a,\n.footer-column li > span {\n  line-height: 1.55;\n}\n\n/* Clearer public labels for the repurposed menu locations. */\n.footer-grid > .footer-column:nth-child(2) h2,\n.footer-grid > .footer-column:nth-child(9) h2,\n.footer-grid > .footer-column:nth-child(10) h2 {\n  font-size: 0;\n}\n\n.footer-grid > .footer-column:nth-child(2) h2::after,\n.footer-grid > .footer-column:nth-child(9) h2::after,\n.footer-grid > .footer-column:nth-child(10) h2::after {\n  display: block;\n  font-size: 0.76rem;\n  line-height: 1.4;\n}\n\n.footer-grid > .footer-column:nth-child(2) h2::after {\n  content: \"OUR MAIN SERVICES\";\n}\n\n.footer-grid > .footer-column:nth-child(9) h2::after {\n  content: \"HELP\";\n}\n\n.footer-grid > .footer-column:nth-child(10) h2::after {\n  content: \"LEGAL\";\n}\n\n.footer-grid > .footer-column:nth-child(9) li:last-child a {\n  color: var(--gold-light);\n  font-weight: 700;\n}\n\n.footer-bottom {\n  gap: 18px;\n  padding-block: 16px;\n}\n\n.footer-legal {\n  padding-bottom: 0;\n}\n\n@media (max-width: 1050px) {\n  .footer-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 36px 28px;\n  }\n\n  .footer-brand {\n    grid-area: auto / 1 / auto / -1;\n    padding-bottom: 8px;\n  }\n}\n\n@media (max-width: 760px) {\n  .site-footer {\n    padding-top: 44px;\n  }\n\n  .footer-grid {\n    gap: 32px 22px;\n    padding-bottom: 38px;\n  }\n\n  .footer-bottom {\n    padding-block: 20px;\n  }\n}\n\n@media (max-width: 520px) {\n  .footer-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 30px 18px;\n  }\n\n  .footer-brand {\n    grid-column: 1 / -1;\n    padding-bottom: 28px;\n    border-bottom: 1px solid var(--border-soft);\n  }\n\n  .footer-column {\n    padding-bottom: 18px;\n  }\n}\n\n@media (max-width: 420px) {\n  .footer-grid {\n    grid-template-columns: 1fr;\n  }\n}/* GemReserve compact institutional footer — 2026-08-31 */\n.site-footer {\n  padding-top: clamp(48px, 5vw, 68px);\n}\n\n.footer-grid {\n  grid-template-columns: minmax(250px, 1.35fr) repeat(4, minmax(140px, 1fr));\n  align-items: start;\n  gap: clamp(28px, 3vw, 48px);\n  padding-bottom: clamp(38px, 4vw, 52px);\n}\n\n.footer-brand {\n  grid-row: auto;\n  align-self: start;\n}\n\n.footer-brand > p {\n  max-width: 30ch;\n}\n\n.footer-socials {\n  display: none;\n}\n\n/* Keep only Services, Company, Help and Legal. */\n.footer-grid > .footer-column:nth-child(n + 3):nth-child(-n + 7) {\n  display: none;\n}\n\n.footer-column h2 {\n  margin-bottom: 14px;\n  letter-spacing: 0.08em;\n}\n\n.footer-column ul {\n  gap: 8px;\n}\n\n.footer-column a,\n.footer-column li > span {\n  line-height: 1.55;\n}\n\n/* Clearer public labels for the repurposed menu locations. */\n.footer-grid > .footer-column:nth-child(2) h2,\n.footer-grid > .footer-column:nth-child(9) h2,\n.footer-grid > .footer-column:nth-child(10) h2 {\n  font-size: 0;\