ots\":[{\"key\":\"c1\",\"kind\":\"text\",\"label\":\"Paragraph\",\"value\":\"Six documents are in preparation. None is downloadable yet, and none is presented as if it were — no file size, no page count, no button. Where a page on this site already covers the same ground, it is linked.\",\"path\":\"/p/p#text\"}]} /--><!-- /wp:gemreserve/wrapper --><!-- wp:gemreserve/wrapper {\"open\":\"\\u003cdiv class=\\u0022motion-reveal\\u0022 style=\\u0022\\u002d\\u002dreveal-delay:80ms\\u0022\\u003e\",\"close\":\"\\u003c/div\\u003e\",\"variant\":\"motion-reveal\"} --><!-- wp:gemreserve/wrapper {\"open\":\"\\u003cul class=\\u0022documents-library__grid\\u0022\\u003e\",\"close\":\"\\u003c/ul\\u003e\",\"variant\":\"documents-library__grid\"} --><!-- wp:gemreserve/content {\"template\":\"\\u003cli class=\\u0022document-card\\u0022\\u003e\\u003cimg alt=\\u0022{{gr_c2}}\\u0022 loading=\\u0022lazy\\u0022 width=\\u0022560\\u0022 height=\\u0022700\\u0022 decoding=\\u0022async\\u0022 data-nimg=\\u00221\\u0022 class=\\u0022document-card__cover\\u0022 style=\\u0022color:transparent\\u0022 sizes=\\u0022(max-width: 760px) 60vw, (max-width: 1180px) 30vw, 16vw\\u0022 srcset=\\u0022/wp-content/themes/gemreserve/assets/images/sections/doc-whitepaper.webp 128w, /wp-content/themes/gemreserve/assets/images/sections/doc-whitepaper.webp 256w, /wp-content/themes/gemreserve/assets/images/sections/doc-whitepaper.webp 384w, /wp-content/themes/gemreserve/assets/images/sections/doc-whitepaper.webp 640w, /wp-content/themes/gemreserve/assets/images/sections/doc-whitepaper.webp 750w, /wp-content/themes/gemreserve/assets/images/sections/doc-whitepaper.webp 828w, /wp-content/themes/gemreserve/assets/images/sections/doc-whitepaper.webp 1080w, /wp-content/themes/gemreserve/assets/images/sections/doc-whitepaper.webp 1200w, /wp-content/themes/gemreserve/assets/images/sections/doc-whitepaper.webp 1920w, /wp-content/themes/gemreserve/assets/images/sections/doc-whitepaper.webp 2048w, /wp-content/themes/gemreserve/asse