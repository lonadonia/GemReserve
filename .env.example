# GemReserve.io — environment template
#
# Copy to `.env.local` for development, or set these on the production host.
# Never commit a filled-in copy: `.gitignore` already excludes `.env*`.
#
# Every variable below is OPTIONAL. With none of them set, the site builds and
# runs as the public pre-launch preview: all pages render, and the lead forms
# report their demonstration state without transmitting anything.
#
# Variables prefixed NEXT_PUBLIC_ are compiled into the browser bundle and are
# publicly readable. Never put a secret behind that prefix.


# --- Public origin ----------------------------------------------------------
# Drives canonical URLs, Open Graph URLs and the sitemap. Set this to the exact
# scheme and host the site is served from, with no trailing slash.
# Default: https://gemreserve.io
NEXT_PUBLIC_SITE_URL=https://gemreserve.io


# --- Search engine indexing -------------------------------------------------
# Set to "false" on ANY non-production deployment (staging, preview, review
# apps). That serves a robots.txt disallowing everything and withholds the
# sitemap, so a preview host cannot compete with production or leak unreleased
# pages into search results.
# Leave unset on production.
# NEXT_PUBLIC_ALLOW_INDEXING=false


# --- Lead form submission ---------------------------------------------------
# Turns the waitlist, contact and early-access forms from preview state into
# real submission. Requires BOTH server variables below to be set as well; with
# the flag on but no destination configured, the API answers 503 and the forms
# correctly fall back to reporting that nothing was sent.
# Default: off.
# NEXT_PUBLIC_ENABLE_FORM_SUBMISSION=true

# Server-only. Read by the API route, never sent to the browser.
# The HTTPS endpoint that receives submissions (CRM, mail relay, form provider).
# FORM_DELIVERY_ENDPOINT=https://provider.example.com/v1/forms

# Server-only. Sent as `Authorization: Bearer <key>`.
# FORM_DELIVERY_API_KEY=


# --- Future ecosystem gates -------------------------------------------------
# All default to OFF and nothing reads them yet. They are declared so the work
# to build each capability has a single, greppable switch, and so a reviewer can
# confirm at a glance that none is live.
#
# Do NOT enable any of these without the legal and infrastructure sign-off
# recorded in docs/PRODUCTION_READINESS_AUDIT.md.
#
# NEXT_PUBLIC_ENABLE_WALLET_CONNECT=false
# NEXT_PUBLIC_ENABLE_TOKEN_SALE=false
# NEXT_PUBLIC_ENABLE_PROOF_OF_RESERVES=false
# NEXT_PUBLIC_ENABLE_REDEMPTION=false
# NEXT_PUBLIC_ENABLE_PARTICIPANT_PORTAL=false
