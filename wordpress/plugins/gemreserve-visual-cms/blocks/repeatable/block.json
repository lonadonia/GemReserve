{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "gemreserve/repeatable",
  "title": "Card list",
  "category": "gemreserve",
  "icon": "grid-view",
  "description": "A repeating set of cards, pillars or steps. Add one, duplicate one, remove one, or drag to reorder. Every card uses the same approved layout.",
  "keywords": ["cards", "grid", "list", "steps", "pillars", "repeat"],
  "textdomain": "gemreserve-visual-cms",
  "supports": {
    "html": false,
    "reusable": false,
    "inserter": false,
    "customClassName": false,
    "color": false,
    "spacing": false,
    "typography": false
  },
  "attributes": {
    "open":         { "type": "string", "default": "" },
    "close":        { "type": "string", "default": "" },
    "itemTemplate": { "type": "string", "default": "" },
    "itemSlots":    { "type": "array",  "default": [] },
    "items":        { "type": "array",  "default": [] },
    "separators":   { "type": "array",  "default": [] },
    "trailing":     { "type": "string", "default": "" },
    "variant":      { "type": "string", "default": "" },
    "hidden":       { "type": "boolean", "default": false }
  },
  "editorScript": "gemreserve-vcms-editor",
  "editorStyle": "gemreserve-vcms-editor",
  "style": "gemreserve"
}
